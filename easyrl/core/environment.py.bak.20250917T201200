from stable_baselines3.common.vec_env import DummyVecEnv, VecNormalize, VecFrameStack
from stable_baselines3.common.env_util import make_vec_env


class Environment:
    """
    Wrapper class for RL environments, managing setup, preprocessing, and interaction compatible with Gymnasium.

    This class creates an environment, applies vectorization and optional preprocessing (e.g., normalization,
    frame stacking), and provides methods to interact with the environment. It stores applied preprocessors
    in a list for reference.

    Attributes:
        env_name (str): The name of the environment, e.g., 'CartPole-v1'. Default is 'CartPole-v1'.
        env (object): The wrapped vectorized environment (e.g., DummyVecEnv with potential wrappers like VecNormalize).
        preprocessors (list): List of applied preprocessors/wrappers (e.g., VecNormalize, VecFrameStack instances).
    """

    def __init__(self, env_config: dict):
        """
        Initializes the Environment instance from a configuration dictionary.

        Args:
            env_config (dict): Configuration for the environment. Expected keys:
                - 'env_name' (str, optional): Name of the environment. Default 'CartPole-v1'.
                - 'normalize' (bool, optional): If True, applies VecNormalize for observation normalization.
                - 'stack_frames' (int, optional): Number of frames to stack if specified (uses VecFrameStack).

        Raises:
            ValueError: If 'env_name' is not a valid environment name or if preprocessing params are invalid.
        """
        try:
            import gymnasium as gym
            from stable_baselines3.common.vec_env import DummyVecEnv, VecNormalize, VecFrameStack
            from stable_baselines3.common.env_util import make_vec_env
            self.env_name = env_config.get('env_name', 'CartPole-v1')
            if not isinstance(self.env_name, str):
                raise ValueError("env_name must be a string.")

            # Create the base environment and wrap it as a vectorized environment
            self.env = make_vec_env(self.env_name, n_envs=1, seed=None)  # n_envs=1 for single env
            self.preprocessors = []  # List to store applied wrappers

            # Apply normalization if specified
            if env_config.get('normalize', False):
                norm_wrapper = VecNormalize(self.env, norm_obs=True, norm_reward=False, clip_obs=10.0)
                self.env = norm_wrapper
                self.preprocessors.append(norm_wrapper)

            # Apply frame stacking if specified
            stack_frames = env_config.get('stack_frames')
            if stack_frames is not None:
                if not isinstance(stack_frames, int) or stack_frames <= 0:
                    raise ValueError("stack_frames must be a positive integer.")
                stack_wrapper = VecFrameStack(self.env, n_stack=stack_frames)
                self.env = stack_wrapper
                self.preprocessors.append(stack_wrapper)

        except Exception as e:
            raise RuntimeError(f"Failed to initialize environment '{self.env_name}': {str(e)}")

    def reset(self):
        """
        Resets the environment and returns the initial observation.

        Returns:
            tuple: A tuple (observation, info), where observation is the initial state as a numpy array,
                   and info is a dictionary containing additional reset information.
        """
        try:
            obs = self.env.reset()
            # For vectorized env with n_envs=1, obs is a 1-element array, extract the first element
            return obs[0], {}
        except Exception as e:
            raise RuntimeError(f"Error resetting environment: {str(e)}")

    def step(self, action):
        """
        Takes an action in the environment and returns the next state, reward, and termination flags.

        Args:
            action: The action to take, compatible with the environment's action space.

        Returns:
            tuple: A tuple (observation, reward, terminated, truncated, info).
                   - observation: The next state as a numpy array.
                   - reward: The reward from the action.
                   - terminated: Boolean indicating if the episode ended (e.g., goal reached or failure).
                   - truncated: Boolean indicating if the episode was truncated (e.g., max steps reached).
                   - info: Dictionary with additional step information.
        """
        try:
            # For vectorized env, pass action as a list/array
            obs, rewards, dones, infos = self.env.step([action])
            # Extract for single env (index 0)
            terminated = dones[0] if dones[0] else False  # Simplified, assuming no early termination
            truncated = False  # VecEnv might not distinguish; handle if needed
            return obs[0], rewards[0], terminated, truncated, infos[0]
        except Exception as e:
            raise RuntimeError(f"Error stepping in environment with action {action}: {str(e)}")

    def close(self):
        """
        Closes the environment, releasing any resources.
        """
        if hasattr(self.env, 'close'):
            self.env.close()